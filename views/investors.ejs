<!DOCTYPE html>
<html>

<head>
    <title><%= labels.appName %></title>
    <link rel="stylesheet" href="css/styles.css">
</head>

<body>
    <div id="top-bar">
        <img src="img/logo.png" alt="Logo" id="logo">
        <h1><%= labels.appName %></h1>
    </div>
    <div id="investors-list">
        <% investors.forEach(investor => { %>
            <div class="investor">
                <h5>
                    <img src="<%= investor.website %>/<%= investor.logo %>" alt="<%= investor.name %>" style="display: inline;width:40px;height:40px;">
                    <a href="<%= investor.website %>" style="display: inline;"><%= investor.name %> </a>
                </h5>
            </div>
        <% }) %>
    </div>
    <!-- <h2>Comments</h2>
    <div id="comments-section">
        !TODO 
    </div>
    -->
    <script src="js/comments.js"></script>
</body>

</html>